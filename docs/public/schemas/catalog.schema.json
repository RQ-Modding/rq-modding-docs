{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rq-modding.github.io/rq-modding-docs/schemas/catalog.schema.json",
  "title": "RQ MOD mods catalog",
  "description": "mods.json: RQ MOD's latest release, RQ Manager's, and the checked mods, each at the release that was checked. Written by the docs' scripts/catalog.py; read by the site's Download and Mods pages and by RQ Manager.",
  "type": "object",
  "required": ["format", "generated", "engine", "mods"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": {
      "const": 1,
      "description": "The file's format. A reader refuses a format it does not know."
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The day the file was written (UTC)."
    },
    "manager": {
      "type": "object",
      "description": "RQ Manager's latest release on GitHub. Optional: absent before its first release. RQ Manager reads it even from a catalog of a newer format, to update itself.",
      "required": ["version", "tag", "published", "notes", "zip"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "tag": { "type": "string" },
        "published": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "format": "uri", "description": "The release's page." },
        "zip": { "$ref": "#/$defs/file", "description": "Holds RQ Manager/rq-manager.exe." }
      }
    },
    "engine": {
      "type": "object",
      "description": "RQ MOD's latest release on GitHub.",
      "required": ["version", "stage", "tag", "published", "notes", "zip"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver", "description": "The loader version (rq.version)." },
        "stage": { "type": "string", "description": "\"Public Beta\" during the beta, \"\" after." },
        "tag": { "type": "string" },
        "published": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "format": "uri", "description": "The release's page." },
        "zip": { "$ref": "#/$defs/file" }
      }
    },
    "mods": {
      "type": "array",
      "items": { "$ref": "#/$defs/mod" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "idList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "file": {
      "type": "object",
      "description": "A release's zip.",
      "required": ["name", "url", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "size": { "type": "integer", "minimum": 1, "description": "Bytes." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "mod": {
      "type": "object",
      "required": ["id", "name", "author", "description", "tags", "save", "version", "loader", "dependencies", "loadAfter", "loadBefore", "conflicts", "license", "repo", "tag", "published", "zip"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "mod.json's id: the folder the zip holds." },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string", "description": "One or two sentences for players." },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["characters", "skills", "items", "battle", "dungeons", "quests", "shops", "interface", "modes", "saves", "fixes"]
          }
        },
        "save": {
          "enum": ["none", "stays"],
          "description": "none: removing the mod leaves the game's save as the game expects it. stays: the save keeps things the mod made (items, skills, values), or removing the mod changes the save; the mod's README says how, under Saves."
        },
        "version": { "$ref": "#/$defs/semver", "description": "The checked release's version (mod.json's)." },
        "loader": { "type": "string", "description": "mod.json's loader: the lowest RQ MOD it needs." },
        "dependencies": { "$ref": "#/$defs/idList" },
        "loadAfter": { "$ref": "#/$defs/idList" },
        "loadBefore": { "$ref": "#/$defs/idList" },
        "conflicts": { "$ref": "#/$defs/idList" },
        "license": { "type": "string", "description": "An SPDX id, such as MIT." },
        "repo": { "type": "string", "format": "uri" },
        "tag": { "type": "string", "description": "The checked release's tag." },
        "published": { "$ref": "#/$defs/date" },
        "zip": { "$ref": "#/$defs/file" }
      }
    }
  }
}
